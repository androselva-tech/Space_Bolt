{
  "name": "space-bolt",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "assets": "cd tools && npm install && node make-art.mjs",
    "test": "jest",
    "test:e2e": "node e2e/playthrough.mjs",
    "test:e2e:all": "node e2e/playthrough.mjs --from 1 --to 27 --skip-movies --keep-going",
    "test:e2e:home": "node e2e/playthrough.mjs --from 21 --to 27 --keep-going",
    "release:android": "node scripts/release-android.mjs",
    "icons": "cd tools && npm install && node make-icons.mjs",
    "demo": "node e2e/playthrough.mjs --headful --from 1 --to 3",
    "demo:all": "node e2e/playthrough.mjs --headful --from 1 --to 27 --skip-movies --keep-going",
    "demo:home": "node e2e/playthrough.mjs --headful --from 21 --to 27 --keep-going"
  },
  "dependencies": {
    "@expo-google-fonts/patrick-hand": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-three/fiber": "^9.8.0",
    "@types/jest": "29.5.14",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "three": "^0.186.0",
    "unity-levelplay-mediation": "^9.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.0",
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "watchman": false
  }
}
